# =============================================================================
# Demo RAG Notebook: Supabase cloud + OpenAI + pgvector
# Sao chép file này thành .env và thay toàn bộ placeholder <...>.
# Không đưa SUPABASE_SERVICE_ROLE_KEY hoặc OPENAI_API_KEY vào frontend.
# =============================================================================

# Ứng dụng
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_AUDIENCE=authenticated

# Durable ingestion worker
INGESTION_WORKER_ENABLED=true
INGESTION_WORKER_CONCURRENCY=2
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_WORKER_LEASE_SECONDS=1800

# Giới hạn 10 MiB phải khớp giữa API, Storage và pipeline validation.
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,docx,txt,pptx,xlsx,csv,md,markdown,html,htm
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv,text/markdown,text/html,application/octet-stream

# Chunking và Advanced Extraction
CHUNK_SIZE=600
CHUNK_OVERLAP=0
CHUNKING_STRATEGY=parent_child_structure
ADVANCED_EXTRACTION_ENABLED=true
EXTRACTION_QUALITY_MODE=rag
MAX_EXTRACTION_PROVIDER_ATTEMPTS=1

# Giữ OCR tắt cho demo path dùng native PDF.
# Để thử PDF scan: chạy "uv sync --extra ocr", sau đó đặt OCR_ENABLED=true.
OCR_ENABLED=false

# OpenAI embedding và chat
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=<openai-api-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_EMBEDDING_BATCH_SIZE=64

# Deterministic document/section headers are the production default. Enable this only
# for contextual-enrichment experiments; raw LLM context did not beat the header baseline.
CONTEXTUAL_ENRICHMENT_ENABLED=false
CONTEXTUAL_ENRICHMENT_MODEL=gpt-4o-mini
CONTEXTUAL_ENRICHMENT_DOCUMENT_MAX_CHARS=12000
CONTEXTUAL_ENRICHMENT_MAX_CONTEXT_CHARS=600
CONTEXTUAL_ENRICHMENT_MAX_CONTEXT_WORDS=45
# Deprecated compatibility control. The v4 enricher does not generate search terms.
CONTEXTUAL_ENRICHMENT_MAX_SEARCH_TERMS=0
CONTEXTUAL_ENRICHMENT_MAX_OUTPUT_TOKENS=400
CONTEXTUAL_ENRICHMENT_MAX_RETRIES=2
CONTEXTUAL_ENRICHMENT_RETRY_BACKOFF_MS=500
CONTEXTUAL_ENRICHMENT_STRICT=false

# Document-level metadata: deterministic sources win; OpenAI only proposes
# missing values with exact page/block evidence and never marks them verified.
DOCUMENT_METADATA_ENRICHMENT_ENABLED=true
DOCUMENT_METADATA_ENRICHMENT_MODEL=gpt-4o-mini
DOCUMENT_METADATA_ENRICHMENT_MAX_CHARS=16000
DOCUMENT_METADATA_ENRICHMENT_MAX_OUTPUT_TOKENS=1200
DOCUMENT_METADATA_ENRICHMENT_STRICT=false

# Embedding được lưu bằng pgvector trong Supabase Postgres ở trên.
VECTOR_STORE_BACKEND=pgvector

# Knowledge quality: off = disabled, shadow = detect only, on = apply safe
# exact-content reuse and retrieval collapse. Fuzzy matches always require review.
KNOWLEDGE_QUALITY_MODE=on
KNOWLEDGE_QUALITY_MAX_PROBE_CHUNKS=8
KNOWLEDGE_QUALITY_CANDIDATES_PER_PROBE=5
KNOWLEDGE_QUALITY_CONFLICT_PROMPT_ENABLED=true

# Structured table facts are an independent rollout path:
# off = no extraction/read; shadow = persist and measure but do not affect answers;
# on = persist and use exact, time-aware fact evidence before vector retrieval.
# If extraction/persistence/search fails, normal chunk/vector ingestion and retrieval continue.
STRUCTURED_FACT_MODE=off
RAG_P5_MODE=shadow
RAG_P5_CONTEXT_MAX_ITEMS=10
RAG_P5_CONTEXT_MAX_CHARACTERS=12000
RAG_P5_CHARACTERS_PER_TOKEN=4.0
RAG_P5_NEAR_DUPLICATE_REPRESENTATIVES=1

# Generation
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
GENERATION_ALLOW_OUTSIDE_KNOWLEDGE=false
CHAT_HISTORY_MAX_TURNS=6

# Hybrid retrieval: PostgreSQL FTS + pgvector -> RRF -> MMR
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_FINAL_TOP_K=6
RETRIEVAL_RRF_K=60
# 0.0 giữ toàn bộ fused candidates; chỉ tăng sau khi đã evaluation trên dataset.
RETRIEVAL_MIN_DENSE_SCORE=0.0
# 1.0 ưu tiên relevance, 0.0 ưu tiên diversity.
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
# Hard filters chỉ được lập từ mã/năm/trạng thái/loại nội dung tường minh.
RETRIEVAL_DOCUMENT_SCOPE_PLANNER_MODE=off
RETRIEVAL_STRUCTURED_FILTERS_ENABLED=false
# Production-first benchmark currently approves only canonical project_code.
RETRIEVAL_STRUCTURED_FILTER_FIELDS=
# Tùy chọn; xem configs/project_registry.example.json.
RETRIEVAL_PROJECT_REGISTRY_PATH=

# =============================================================================
# Langfuse observability
#
# Content capture is off by default: traces include ids, counts, latency,
# retrieval scores, models, token usage and errors, but redact questions,
# document text, prompts and generated answers.
# =============================================================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false

# =============================================================================
# Frontend Enterprise Knowledge
#
# Các biến VITE_* phải được đặt trong frontend/.env.local khi chạy/build Vite;
# chúng được liệt kê tại đây để release checklist có một nguồn cấu hình chung.
# Domain phía client chỉ phục vụ UX. Trigger database của migration 23 mới là
# lớp cưỡng chế cuối cùng cho auth.users khi bảng allowlist có domain ACTIVE.
# =============================================================================
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_API_URL=http://127.0.0.1:8000
VITE_ENTERPRISE_KB_ENABLED=true
VITE_SELF_SIGNUP_ENABLED=false
VITE_COMPANY_EMAIL_DOMAINS=company.example
